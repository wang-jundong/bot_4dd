# Live is the only supported execution mode.
# Strategy, size, slippage, and entry limits are in src/config/trade.ts and src/config/strategyV0*.ts.
EXECUTION_MODE=live
TARGET_WALLET=4DdrfiDHpmx55i4SPssxVzS9ZaKLb8qr45NKY9Er9nNh
BLOCKED_MINTS=
VIBE_GRPC_ENDPOINT=https://elite.grpc.solanavibestation.com
# Access/bearer token supplied by the Vibe Station gRPC provider.
VIBE_GRPC_TOKEN=
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
HELIUS_SENDER_SWQOS_ONLY=true

WALLET_KEY_FILE=
TRADING_PRIVATE_KEY_ENCRYPTED=

PRIORITY_FEE_LAMPORTS=
HELIUS_TIP_LAMPORTS=5000
COMPUTE_UNIT_LIMIT=
EVENT_RETENTION_SEC=180
BLOCKHASH_REFRESH_MS=10000
LOG_LEVEL=info
RECOVERY_PATH=./recovery/lifecycle.jsonl
PNL_PATH=./logs/pnl.jsonl
